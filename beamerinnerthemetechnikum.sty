                    \def\@listi{\leftmargin\leftmargini \parsep 0pt \topsep 0.3em plus 0.2em minus 0.1em \itemsep 0.6em plus 0.3em minus 0.4em}%
                    \def\@listii{\leftmargin\leftmarginii \parsep 0pt \topsep 0.2em \itemsep 0.6em plus 0.3em minus 0.4em}%
                    \def\@listiii{\leftmargin\leftmarginiii \parsep 0pt \topsep 0.2em \itemsep 0.5em plus 0.2em minus 0.3em}%
                    \setbeamercolor{itemize item}{fg=red!90!black}%
                    \setbeamercolor{itemize subitem}{fg=red!80!black}%
